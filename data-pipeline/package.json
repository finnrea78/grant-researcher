{
  "name": "data-pipeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ingest": "node --env-file=.env --import=tsx src/cli.ts",
    "ingest-all": "node --env-file=.env --import=tsx src/cli.ts ingest-all",
    "ingest:ci": "node --import=tsx src/cli.ts",
    "embed": "node --env-file=.env --import=tsx src/cli.ts embed",
    "claude-extract": "node --import=tsx src/cli.ts claude-extract",
    "list-funders": "node --import=tsx src/cli.ts list-funders",
    "test": "jest"
  },
  "dependencies": {
    "@grant-researcher/db": "*",
    "@supabase/supabase-js": "^2.49.0",
    "cheerio": "^1.0.0",
    "commander": "^13.0.0",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@grant-researcher/db$": "<rootDir>/../db/src/index.ts"
    }
  }
}
